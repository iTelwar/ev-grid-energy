# Public site URL used for canonical URLs, sitemap and Open Graph.
# Inlined at build time (the Dockerfile sets it for production builds).
NEXT_PUBLIC_SITE_URL=https://evgridenergy.com

# Lead storage (DynamoDB) and sales notifications (SNS). Set by the ECS task
# definition in production; neither value is a secret.
# Production refuses to acknowledge a lead if LEADS_TABLE_NAME is unset.
# In development, leave both empty: leads are validated and only their
# reference is logged.
LEADS_TABLE_NAME=
LEAD_NOTIFICATIONS_TOPIC_ARN=
